# === LLM ===
# 预算为 0 = 无限（仅建议本地测试期使用）；生产恢复 500000/100000。
PROVIDER=deepseek
FALLBACK_CHAIN=["deepseek","openai","ollama"]
TIMEOUT_SECONDS=30
MAX_RETRIES=2
DAILY_TOKEN_BUDGET=500000
PER_AGENT_BUDGET=100000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === Embedding ===
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === WeChat Decrypt ===
WECHAT_KEY=
WECHAT_DB_PATH=
WECHAT_VERSION=4
WECHAT_YINYUE_WXID=
WECHAT_OWNER_WXIDS=
WECHAT_SEND_ENABLED=false
WECHAT_SEND_MIN_INTERVAL=2.0

# === Platform Accounts (多平台扩展用) ===
# PLATFORMS_BILIBILI_ACCOUNT=
# PLATFORMS_BILIBILI_OWNER_ACCOUNTS=
# PLATFORMS_DOUYIN_ACCOUNT=
# PLATFORMS_DOUYIN_OWNER_ACCOUNTS=
# PLATFORMS_QQ_ACCOUNT=
# PLATFORMS_QQ_OWNER_ACCOUNTS=

# === Sync ===
SYNC_INTERVAL_MINUTES=30

# === Time Awareness ===
# IANA timezone for displayed times; empty = system local time.
TEMPORAL_TIMEZONE=Asia/Shanghai
TEMPORAL_HISTORY_RELATIVE_DAYS=7
TEMPORAL_STALE_MESSAGE_HOURS=48
TEMPORAL_QUIET_HOURS_START=23
TEMPORAL_QUIET_HOURS_END=7

# === Agents ===
ENABLED_AGENTS=private_chat,group_chat,relevance,daily_digest

# === User Profile ===
USER_KEYWORDS=
USER_PROJECTS=
USER_FREQUENT_CONTACTS=
USER_IGNORE_GROUPS=

# === Classifier ===
USER_CLASSIFIER_ENABLED=true
USER_CLASSIFIER_MIN_RELEVANCE=0.1
USER_CLASSIFIER_URGENT_KEYWORDS=
USER_CLASSIFIER_TASK_KEYWORDS=

# === Search ===
# search_messages 默认往前搜索的小时数；0 = 不限时间
SEARCH_DEFAULT_HOURS_BACK=24

# === Web ===
WEB_HOST=127.0.0.1
WEB_PORT=8972

# === Paths ===
DATA_DIR=./data
DECRYPTED_DIR=./data/decrypted
OUTPUT_DIR=./output
LOG_DIR=./logs

# === Refactor Feature Flags (default off) ===
# P0/P1 foundation: canonical contracts + decision tracing.
# The conversation shadow writes its own addressee_shadow rows, so this flag
# only controls the broader route/decision trace.
YINYUE_FEATURE_DECISION_TRACE=0
# Optional override for the trace sink; default is logs/decision_trace.jsonl
# YINYUE_DECISION_TRACE_PATH=./logs/decision_trace.jsonl
# YINYUE_DECISION_TRACE_MAX_MB=32   # canonical trace 超过该大小即轮转；<=0 关闭
# YINYUE_DECISION_TRACE_BACKUPS=3   # 保留 .1 ... .N 份
# Reserved for the next increments; keep disabled until validated in shadow mode.
# Optional override; default is logs/message_events_shadow.jsonl
YINYUE_FEATURE_ENRICHMENT_ARTIFACTS=0
# Cross-account message/evidence index; safe to enable after first migration.
# The scheduler runs a resumable cursor worker when enabled.
YINYUE_FEATURE_EVIDENCE_INDEX=0
# Worker page size and per-sync page cap (defaults 500 / 10).
# YINYUE_EVIDENCE_INDEX_BATCH_SIZE=500
# YINYUE_EVIDENCE_INDEX_MAX_BATCHES=10
# Real shadow run: observe addressee decisions without changing routing.
YINYUE_FEATURE_CONVERSATION_SHADOW=0
# Canary: allow the resolver to add follow-up replies in allowlisted groups.
YINYUE_FEATURE_CONVERSATION_ACTIVE=0
YINYUE_CONVERSATION_ACTIVE_GROUPS=
# strict = only @ / quote / same-person continuation (rollout phase 1)
# smart  = full resolver reply set (enable after strict stays clean)
# Default is strict when unset.
# YINYUE_CONVERSATION_ACTIVE_MODE=strict
# Optional strict-mode safety floor for same-person continuations (0.0-1.0).
# Explicit @ / quote replies are not affected. Suggested first canary: 0.62.
# YINYUE_CONVERSATION_STRICT_MIN_SCORE=0.0
# Resolver tuning overrides.  Apply the JSON suggestion from
# core.conversation.tune, or set the explicit variables below.
# YINYUE_CONVERSATION_TUNING_FILE=output/conversation_tuning.json
# YINYUE_CONVERSATION_WEIGHTS={"same_sender":0.2,"bot_asked_question":0.2}
# YINYUE_CONVERSATION_REPLY_THRESHOLD=0.75
# YINYUE_CONVERSATION_OPEN_REPLY_THRESHOLD=0.55
# YINYUE_CONVERSATION_OBSERVE_THRESHOLD=0.35
# Reconcile send_log confirmed_msg_id back into conversation windows.
YINYUE_FEATURE_OUTBOUND_RECONCILE=0

# --- Affect (心境/情感) ----------------------------------------------------
# Split the same way person memory is: AFFECT maintains and persists the
# state on the relationships row (columns warmth / warmth_reason /
# warmth_updated_at), and AFFECT_PROMPT is the separate decision to let it
# change what she says.  Start with AFFECT only and watch the
# affect_observed log lines plus the warmth column before enabling the prompt.
# Scope today is the owner's one-to-one chats; groups never render a block.
YINYUE_FEATURE_AFFECT=0
YINYUE_FEATURE_AFFECT_PROMPT=0
# Where the affect wording/thresholds live.  Edit that JSON to retune her
# voice; the loader re-reads it on change, so no restart is needed.
# YINYUE_AFFECT_CONFIG=configs/speech_seed/affect_yinyue.json

# --- Terminal refactor (Phase 5) ----------------------------------------------
# Formal SQLite event stream (meta DB ``terminal_events``).  This is the only
# recording path; keep it on for every real run.
# Bounded deterministic recall over terminal_events.  Phase C moves all long
# term memory reads here; the flag stays until that migration is proven.
# Deterministic identity / Authority is always on and intentionally has no
# feature flag.  Never add one, and never fall back to owner-id lists or
# display names for owner/capability decisions.

# --- Terminal refactor Phase 4: automatic proactive decision ------------------
# When on, the scheduler periodically scans conversations explicitly listed in
# the Web proactive whitelist, picks idle/overdue ones, and publishes
# PROACTIVE_TRIGGER.  The model behind the trigger may still answer [静默],
# and OutboundGateway always re-checks whitelist/quiet-hours/rate limits.
# Off by default: no automatic proactive contact happens until enabled.
# How often the scanner wakes up.
# YINYUE_PROACTIVE_SCAN_INTERVAL_MINUTES=30
# A conversation must be quiet at least this long before it is considered.
# YINYUE_PROACTIVE_MIN_IDLE_MINUTES=180
# Only conversations with a message in this lookback window are considered.
# YINYUE_PROACTIVE_HISTORY_DAYS=14
# Per-conversation retry spacing when the model answered [静默].
# YINYUE_PROACTIVE_ATTEMPT_INTERVAL_MINUTES=240
# At most this many trigger events per scan (bounded model cost).
# YINYUE_PROACTIVE_MAX_PER_CYCLE=2
# Max seconds one scan waits for its PROACTIVE_TRIGGER turns to finish.
# YINYUE_PROACTIVE_TRIGGER_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Web 控制台
# 可选访问令牌：留空 = 不校验（仅本机 127.0.0.1 绑定安全）。
# 若把 WEB_HOST 开到局域网/公网，必须设置 WEB_TOKEN，否则启动会打印告警。
# 设置后浏览器第一次用 http://host:port/?token=... 打开即可（会写 cookie）。
# ---------------------------------------------------------------------------
# WEB_TOKEN=

# ---------------------------------------------------------------------------
# L2 准入层（core/context/admission.py；设计：docs/架构文档.md §三）
# off（默认）/ shadow（只判定+记录，不改生成）/ on（用准入后的上下文生成）
# 先 shadow 跑 1~2 天；看板：python scripts/admission_board.py
# ---------------------------------------------------------------------------
# YINYUE_ADMISSION_MODE=off
# 可选：只在这些会话生效（留空 = 跟随 YINYUE_CHAT_WINDOW_CHATS 白名单）
# YINYUE_ADMISSION_CHATS=

# ---------------------------------------------------------------------------
# WP-08 8.2 extra 契约运行期守卫（agents/base.py::ExtraDict）
# off = 不检查 / warn（默认）= 未知键记 warning / strict = 未知键抛错（测试用）
# 契约键登记在 core/routing/turn_pipeline.py::EXTRA_CONTRACT；新增键必须说明读者。
# ---------------------------------------------------------------------------
# YINYUE_EXTRA_CONTRACT_MODE=strict  # 默认 strict；off/warn 仅用于回滚
