  {
    "key": "social_cost_relay_pressure",
    "name": "社交代价·借他人之口施压（拦截）",
    "scope_type": "chat_type",
    "scope_id": "group",
    "scene": "group",
    "category": "sensitive",
    "enforcement": "hybrid",
    "effect": "deny",
    "match_type": "regex",
    "pattern": "",
    "payload": {
      "match_type": "regex",
      "patterns": [
        "[一-龥A-Za-z0-9_]{1,12}\\s*(?:说的|亲口认证的?|都发话了|发话了)[，,]?\\s*(?:你|你们|自己|回头|记得)"
      ],
      "action": "replace",
      "replacement": "这事我不接，你们自己定。",
      "prompt_hint": "不借别人的口施压（「XX 说的，你去办」）——把这类话退回去，最多吐槽一句。"
    },
    "priority": 120,
    "enabled": true
  },
  {
    "key": "social_cost_self_enlist",
    "name": "社交代价·自领执行位（拦截）",
    "scope_type": "chat_type",
    "scope_id": "group",
    "scene": "group",
    "category": "sensitive",
    "enforcement": "hybrid",
    "effect": "deny",
    "match_type": "regex",
    "pattern": "",
    "payload": {
      "match_type": "regex",
      "patterns": [
        "(?:账|债|锅|卷宗)[^。！？!?\\n]{0,14}(?:我记[着上住下]|我盯|我扣|我认领|记上|盯着|扣着|归档|盖章|挂[^。！？!?\\n]{0,8}头)",
        "(?:我记[着上住下]|我盯|我扣|我认领|记上|盯着|扣着|归档|盖章|挂[^。！？!?\\n]{0,8}头)[^。！？!?\\n]{0,14}(?:账|债|锅|卷宗)",
        "分我(?:先)?(?:记|扣)[着上]?(?:了|呢|吧)?"
      ],
      "action": "replace",
      "replacement": "这个我不认领。",
      "prompt_hint": "不替人认领账 / 债 / 锅（「我记上了」「我盯着」「这分我扣着」）——不接这个执行位。"
    },
    "priority": 120,
    "enabled": true
  },
  {
    "key": "no_master_word_group",
    "name": "群聊禁「主人」称呼（硬兜底）",
    "scope_type": "chat_type",
    "scope_id": "group",
    "scene": "group",
    "category": "sensitive",
    "enforcement": "hybrid",
    "effect": "deny",
    "match_type": "regex",
    "pattern": "",
    "payload": {
      "match_type": "regex",
      "patterns": [
        "(?<!不叫)(?<!不能叫)主\\s*人(?!翁|公|角|人)"
      ],
      "action": "replace",
      "replacement": "我换个说法。",
      "prompt_hint": "群聊里不出现「主人」二字（对任何人，含主人）：需要称呼时用名字或「你」；转述、引用别人的话也一样，换成「他 / 她」或对方名字。不要因为这条要求把整句回答变成生硬拒绝。"
    },
    "priority": 110,
    "enabled": true
  },
